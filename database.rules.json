{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "tracker": {
          "trackers": {
            "$tid": {
              ".read": "auth != null && auth.token.email_verified === true && root.child('users').child($uid).child('acl').child('trackers').child($tid).child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
            }
          },
          "sheets": {
            "$sid": {
              ".read": "auth != null && auth.token.email_verified === true && root.child('users').child($uid).child('acl').child('sheets').child($sid).child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
              ".write": "auth != null && auth.token.email_verified === true && newData.exists() && data.exists() && root.child('users').child($uid).child('acl').child('sheets').child($sid).child(auth.token.email.toLowerCase().replace('.', ',')).val() === 'edit'"
            }
          },
          "rows": {
            ".indexOn": ["sheetId"],
            ".read": "auth != null && auth.token.email_verified === true && query.orderByChild === 'sheetId' && query.equalTo != null && root.child('users').child($uid).child('acl').child('sheets').child(query.equalTo).child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
            "$rid": {
              ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || root.child('users').child($uid).child('acl').child('sheets').child(data.child('sheetId').val()).child(auth.token.email.toLowerCase().replace('.', ',')).val() === 'edit') && (!newData.exists() || root.child('users').child($uid).child('acl').child('sheets').child(newData.child('sheetId').val()).child(auth.token.email.toLowerCase().replace('.', ',')).val() === 'edit')"
            }
          },
          "dashboards": {
            "$did": {
              ".read": "auth != null && auth.token.email_verified === true && root.child('users').child($uid).child('acl').child('dash').child($did).child(auth.token.email.toLowerCase().replace('.', ',')).exists()"
            }
          }
        }
      }
    },

    "inbox": {
      "$ek": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $ek",
        "$item": {
          ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid))"
        }
      }
    },

    "shares": {
      "$shareId": {
        ".read": "data.child('mode').val() === 'link' || (auth != null && (data.child('owner').val() === auth.uid || (auth.token.email_verified === true && data.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).exists())))",
        ".write": "auth != null && ((data.exists() && data.child('owner').val() === auth.uid) || (!data.exists() && newData.child('owner').val() === auth.uid))"
      }
    }
  }
}
